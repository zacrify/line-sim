# Port for the simulator. Point your app's LINE API base URL here.
PORT=5531

# One channel: where webhooks go, and the channel secret your app verifies them with.
WEBHOOK_URL=http://localhost:3000/api/line/webhook
CHANNEL_SECRET=change-me

# More channels (optional), as a JSON array:
# CHANNELS=[{"name":"trade","webhookUrl":"http://localhost:3000/api/line/webhook/trade","secret":"change-me-too"}]
